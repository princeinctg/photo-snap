# ========================================================
# PHOTO STUDIO OS — ENVIRONMENT VARIABLES CONFIGURATION
# ========================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication Secret (Generate with: openssl rand -base64 32)
AUTH_SECRET=super_secret_jwt_key_min_32_characters_random_string

# MongoDB Connection String (Atlas URI or Local MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/photo_studio_os?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/photo_studio_os

# --------------------------------------------------------
# IMAGE UPLOAD STORAGE — CLOUDINARY (Recommended)
# --------------------------------------------------------
# Cloudinary Free Tier: 25 GB storage, 25 GB bandwidth/month
# Sign up for free at: https://cloudinary.com/
#
# How to find these values after signing up:
#   1. Log in to cloudinary.com → Dashboard
#   2. Copy "Cloud name", "API Key", and "API Secret"
#
# When all three values below are set (and not the placeholder),
# the app automatically uses Cloudinary for all image uploads.
# Without these, uploads fall back to local /public/uploads/ (dev only).
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --------------------------------------------------------
# Optional: Upload folder prefix in Cloudinary
# All uploads are organized into subfolders automatically:
#   photo-studio-os/settings/logos/
#   photo-studio-os/clients/avatars/
#   photo-studio-os/packages/covers/
#   photo-studio-os/galleries/covers/
# --------------------------------------------------------

# Default Studio Currency Symbol & Code
NEXT_PUBLIC_DEFAULT_CURRENCY=BDT
NEXT_PUBLIC_DEFAULT_CURRENCY_SYMBOL=৳

# Initial Studio Owner Setup (Used during initial installation or seed)
INITIAL_ADMIN_EMAIL=owner@photostudio.com
INITIAL_ADMIN_PASSWORD=StudioAdmin123!
